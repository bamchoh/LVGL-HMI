# build output (build/, build-fbdev/, build-fbdev-aarch64/, ...)
build/
build-*/
_deps/

# test artifacts
*.bmp
*.log
# system log databases written by the runtime ("system_log" in project.json)
projects/*/logs/
__pycache__/

# editor / IDE
.vs/
.vscode/
.idea/
*.swp

# what a device keeps for itself (written by a run of the runtime)
projects/*/project.local.json
