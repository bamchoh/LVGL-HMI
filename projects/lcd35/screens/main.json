      "style": {
        "bg_color": "#1f2a38",
        "radius": 0,
        "border_width": 0,
        "pad": 0,
        "pad_column": 6
      },
      "children": [
        {
          "type": "button",
          "text": "Main",
          "w": 72,
          "h": 36,
          "style": {
            "radius": 6,
            "pad": 0,
            "bg_color": "#1565c0"
          },
          "on_click": {
            "action": "goto",
            "screen": "main",
            "anim": "none"
          }
        },
        {
          "type": "button",
          "text": "Trend",
          "w": 72,
          "h": 36,
          "style": {
            "radius": 6,
            "pad": 0,
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "trend",
            "anim": "none"
          }
        },
        {
          "type": "button",
          "text": "Alarms",
          "w": 72,
          "h": 36,
          "style": {
            "radius": 6,
            "pad": 0,
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "alarms",
            "anim": "none"
          }
        },
        {
          "type": "button",
          "text": "Recipes",
          "w": 72,
          "h": 36,
          "style": {
            "radius": 6,
            "pad": 0,
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "recipes",
            "anim": "none"
          }
        },
        {
          "type": "button",
          "text": "Widgets",
          "w": 72,
          "h": 36,
          "style": {
            "radius": 6,
            "pad": 0,
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "widgets",
            "anim": "none"
          }
        },
        {
          "type": "button",
          "text": "Setup",
          "w": 72,
          "h": 36,
          "style": {
            "radius": 6,
            "pad": 0,
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "settings",
            "anim": "none"
          }
        }
      ]
    },
    {
      "type": "keyboard",
      "align": "bottom_mid",
      "w": "100%",
      "h": 190,
      "style": {
        "pad": 4,
        "pad_gap": 4
      },
      "style_items": {
        "font": 18
      }
    }
  ]
}
