{
  "title": "HML Demo - Pump Station (3.5in 480x320 LCD)",
  "display": {
    "width": 480,
    "height": 320,
    "fbdev": "/dev/fb0",
    "touch": {
      "swap_axes": true,
      "calibration": [
        150,
        3850,
        3850,
        220
      ]
    }
  },
  "theme": {
    "dark": true,
    "primary": "#2196f3",
    "secondary": "#ff9800",
    "font": 14
  },
  "start_screen": "main",
  "tags": [
    {
      "name": "temp",
      "type": "float",
      "init": 20.0
    },
    {
      "name": "pressure",
      "type": "float",
      "init": 1.5
    },
    {
      "name": "level",
      "type": "int",
      "init": 0,
      "min": 0,
      "max": 100
    },
    {
      "name": "speed_sp",
      "type": "int",
      "init": 40,
      "min": 0,
      "max": 100
    },
    {
      "name": "speed_pv",
      "type": "int",
      "init": 0,
      "min": 0,
      "max": 100
    },
    {
      "name": "run",
      "type": "bool",
      "init": false
    },
    {
      "name": "auto_mode",
      "type": "bool",
      "init": true
    },
    {
      "name": "state_text",
      "type": "string",
      "init": "Idle"
    },
    {
      "name": "mode",
      "type": "int",
      "init": 0,
      "min": 0,
      "max": 2
    },
    {
      "name": "setpoint",
      "type": "int",
      "init": 50,
      "min": 0,
      "max": 100
    },
    {
      "name": "operator",
      "type": "string",
      "init": ""
    },
    {
      "name": "plc_online",
      "type": "bool",
      "init": false
    },
    {
      "name": "blink",
      "type": "bool",
      "init": false
    },
    {
      "name": "pin",
      "type": "string",
      "init": ""
    },
    {
      "name": "temp_lo",
      "type": "float",
      "init": 20.0,
      "min": 0,
      "max": 50
    },
    {
      "name": "temp_hi",
      "type": "float",
      "init": 30.0,
      "min": 0,
      "max": 50
    },
    {
      "name": "pump_state",
      "type": "int",
      "init": 0,
      "min": 0,
      "max": 3
    },
    {
      "name": "noise",
      "type": "float",
      "init": 0
    },
    {
      "name": "counter",
      "type": "int",
      "init": 0,
      "min": 0,
      "max": 999
    },
    {
      "name": "jog",
      "type": "bool",
      "init": false
    }
  ],
  "drivers": [
    {
      "type": "sim",
      "items": [
        {
          "tag": "temp",
          "mode": "sine",
          "min": 18,
          "max": 32,
          "period_ms": 12000
        },
        {
          "tag": "pressure",
          "mode": "triangle",
          "min": 1.0,
          "max": 3.5,
          "period_ms": 7000
        },
        {
          "tag": "level",
          "mode": "ramp",
          "min": 0,
          "max": 100,
          "period_ms": 20000
        },
        {
          "tag": "blink",
          "mode": "square",
          "period_ms": 1000
        },
        {
          "tag": "noise",
          "mode": "random",
          "min": 0,
          "max": 10,
          "period_ms": 500
        }
      ]
    },
    {
      "type": "opcua_server",
      "port": 4840,
      "namespace": "urn:hml:runtime",
      "folder": "HML"
    },
    {
      "type": "modbus_tcp",
      "enabled": true,
      "host": "127.0.0.1",
      "port": 5020,
      "unit_id": 1,
      "poll_ms": 200,
      "timeout_ms": 1000,
      "status_tag": "plc_online",
      "map": [
        {
          "tag": "speed_sp",
          "area": "holding",
          "addr": 0
        },
        {
          "tag": "speed_pv",
          "area": "input",
          "addr": 0
        },
        {
          "tag": "setpoint",
          "area": "holding",
          "addr": 1
        },
        {
          "tag": "temp_lo",
          "area": "holding",
          "addr": 2,
          "dtype": "s16",
          "scale": 0.1
        },
        {
          "tag": "temp_hi",
          "area": "holding",
          "addr": 3,
          "dtype": "s16",
          "scale": 0.1
        },
        {
          "tag": "run",
          "area": "coil",
          "addr": 0
        },
        {
          "tag": "auto_mode",
          "area": "coil",
          "addr": 1
        }
      ]
    }
  ],
  "data_log": {
    "groups": [
      {
        "name": "process",
        "trigger": "interval",
        "interval_ms": 1000,
        "tags": [
          "temp",
          "pressure",
          "level",
          "speed_sp",
          "speed_pv"
        ]
      },
      {
        "name": "state",
        "trigger": "change",
        "tags": [
          "run",
          "auto_mode",
          "mode",
          "pump_state"
        ]
      }
    ]
  },
  "alarms": {
    "items": [
      {
        "name": "temp_high",
        "tag": "temp",
        "condition": "gt",
        "value_tag": "temp_hi",
        "severity": "warning",
        "message": "Temperature high"
      },
      {
        "name": "temp_low",
        "tag": "temp",
        "condition": "lt",
        "value_tag": "temp_lo",
        "severity": "warning",
        "message": "Temperature low"
      },
      {
        "name": "level_high",
        "tag": "level",
        "condition": "ge",
        "value": 95,
        "severity": "info",
        "ack": false,
        "message": "Level high"
      }
    ]
  },
  "users": {
    "levels": [
      "Operator",
      "Maintenance",
      "Admin"
    ],
    "list": [
      {
        "name": "operator",
        "level": 1,
        "pin": "1111"
      },
      {
        "name": "maint",
        "level": 2,
        "pin": "2222"
      },
      {
        "name": "admin",
        "level": 3,
        "pin": "0000"
      }
    ],
    "auto_logout_s": 300
  },
  "operation_log": {
    "user_tag": "operator"
  },
  "system_log": {
    "retention_days": 30,
    "max_rows": 100000
  },
  "scripts": [
    {
      "name": "auto_speed",
      "trigger": "interval",
      "code": "-- Auto mode: while the pump runs, the speed setpoint follows the temperature\n-- (18 C -> 0 %, 32 C -> 100 %). Switch \"Auto mode\" off to use the slider.\nif tag.auto_mode and tag.run then\n  local pct = (tag.temp - 18) / (32 - 18) * 100\n  tag.speed_sp = math.floor(math.max(0, math.min(100, pct)) + 0.5)\nend\n",
      "interval_ms": 500
    },
    {
      "name": "pump",
      "trigger": "interval",
      "interval_ms": 200,
      "code": [
        "-- The pump of the demo. Without a PLC (the Modbus driver is not connected) the HMI plays it",
        "-- itself: the speed follows the setpoint while Run is on and falls to 0 when it is off.",
        "if not tag.plc_online then",
        "  local target = tag.run and tag.speed_sp or 0",
        "  local pv = tag.speed_pv",
        "  if pv < target then pv = math.min(target, pv + 4) elseif pv > target then pv = math.max(target, pv - 4) end",
        "  tag.speed_pv = pv",
        "end",
        "-- What the pump is doing: 0 idle, 1 starting, 2 running, 3 stopping (the main screen shows it).",
        "local pv, state = tag.speed_pv, 0",
        "if tag.run then state = (pv < tag.speed_sp - 8) and 1 or 2 elseif pv > 0 then state = 3 end",
        "tag.pump_state = state",
        "tag.state_text = ({ 'Idle', 'Starting', 'Running', 'Stopping' })[state + 1]"
      ]
    }
  ],
  "screens": [
    "screens/main.json",
    "screens/trend.json",
    "screens/alarms.json",
    "screens/recipes.json",
    "screens/widgets.json",
    "screens/settings.json",
    "screens/temp_detail.json"
  ],
  "recipes": {
    "level": 2,
    "books": [
      {
        "name": "process",
        "items": [
          "speed_sp",
          "setpoint",
          "temp_lo",
          "temp_hi",
          "auto_mode"
        ],
        "recipes": [
          {
            "name": "Standard",
            "values": {
              "speed_sp": 60,
              "setpoint": 50,
              "temp_lo": 20,
              "temp_hi": 30,
              "auto_mode": true
            }
          },
          {
            "name": "Gentle",
            "values": {
              "speed_sp": 35,
              "setpoint": 40,
              "temp_lo": 22,
              "temp_hi": 28,
              "auto_mode": true
            }
          },
          {
            "name": "Cleaning",
            "values": {
              "speed_sp": 90,
              "setpoint": 10,
              "temp_lo": 10,
              "temp_hi": 45,
              "auto_mode": false
            }
          }
        ]
      }
    ]
  }
}
