    },
    {
     "type": "label",
     "x": 136,
     "y": 24,
     "style": {
      "font": 48,
      "text_color": "#e5edf5"
     },
     "bind": {
      "text": {
       "tag": "sys.alarm.unacked",
       "format": "%d"
      },
      "text_color": {
       "tag": "sys.alarm.unacked",
       "map": {
        "0": "#36c98f",
        "default": "#f5b942"
       }
      }
     }
    },
    {
     "type": "label",
     "text": "Tap a row to acknowledge it.",
     "x": 0,
     "y": 92,
     "style": {
      "font": 14,
      "text_color": "#91a0b4"
     }
    },
    {
     "type": "button",
     "w": 288,
     "h": 64,
     "style": {
      "bg_color": "#19707c",
      "radius": 10,
      "shadow_width": 0,
      "pad_gap": 8
     },
     "on_click": {
      "action": "call",
      "fn": "alarm.ack_all"
