      "font": 48,
      "text_color": "#e5edf5"
     },
     "bind": {
      "text": {
       "tag": "sys.alarm.active",
       "format": "%d"
      },
      "text_color": {
       "tag": "sys.alarm.active",
       "map": {
        "0": "#36c98f",
        "default": "#f06464"
       }
      }
     }
    },
    {
     "type": "label",
     "text": "Unacknowledged",
     "x": 136,
     "y": 0,
     "style": {
      "font": 16,
      "text_color": "#91a0b4"
