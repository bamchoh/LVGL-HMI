     "flex": "row",
     "flex_main": "center",
     "flex_cross": "center",
     "flex_track": "center",
     "children": [
      {
       "type": "image",
       "src": "assets/icons/24/check.png",
       "style": {
        "image_recolor": "#e5edf5"
       }
      },
      {
       "type": "label",
       "text": "ACKNOWLEDGE ALL",
       "style": {
        "font": 18,
        "text_color": "#e5edf5"
       }
      }
     ],
     "x": 0,
     "y": 136
    }
   ]
  },
