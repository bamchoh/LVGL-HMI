{
 "name": "alarms",
 "template": "frame",
 "template_args": {
  "title": "Alarm Monitor"
 },
 "children": [
  {
   "type": "panel",
   "x": 16,
   "y": 80,
   "w": 912,
   "h": 544,
   "style": {
    "bg_color": "#192538",
    "radius": 12,
    "pad": 16,
    "border_width": 0
   },
   "scrollable": false,
   "children": [
    {
     "type": "label",
     "text": "CURRENT ALARMS",
     "x": 0,
     "y": 12,
     "style": {
      "font": 16,
      "text_color": "#26c6da",
      "text_letter_space": 1
     },
     "bind": {
      "visible": {
       "tag": "alarm_view",
       "eq": 0
      }
     }
    },
    {
     "type": "label",
     "text": "ALARM HISTORY (7 days)",
     "x": 0,
     "y": 12,
     "style": {
      "font": 16,
      "text_color": "#26c6da",
      "text_letter_space": 1
     },
     "bind": {
      "visible": {
       "tag": "alarm_view",
       "eq": 1
      }
     }
    },
    {
     "type": "panel",
     "y": 0,
     "w": 312,
     "h": 48,
     "style": {
      "pad_gap": 8,
      "pad": 0,
      "bg_opa": 0,
      "radius": 0,
      "border_width": 0
     },
     "scrollable": false,
     "flex": "row",
     "align": "top_right",
     "children": [
      {
       "type": "button",
       "w": 152,
       "h": 48,
       "style": {
        "bg_color": "#22314a",
        "radius": 10,
        "shadow_width": 0
       },
       "on_click": {
        "action": "set",
        "tag": "alarm_view",
        "value": 0
       },
       "text": "Current",
       "style_label": {
        "font": 16,
        "text_color": "#e5edf5"
       },
       "checkable": true,
       "bind": {
        "checked": {
         "tag": "alarm_view",
         "eq": 0
        }
       },
       "style_checked": {
        "bg_color": "#19707c"
       }
      },
      {
       "type": "button",
       "w": 152,
       "h": 48,
       "style": {
        "bg_color": "#22314a",
        "radius": 10,
        "shadow_width": 0
       },
       "on_click": {
        "action": "set",
        "tag": "alarm_view",
        "value": 1
       },
       "text": "History",
       "style_label": {
        "font": 16,
        "text_color": "#e5edf5"
       },
       "checkable": true,
       "bind": {
        "checked": {
         "tag": "alarm_view",
         "eq": 1
        }
       },
       "style_checked": {
        "bg_color": "#19707c"
       }
      }
     ]
    },
    {
     "type": "alarm_list",
     "x": 0,
     "y": 64,
     "w": 880,
     "h": 448,
     "mode": "current",
     "row_height": 48,
     "columns": [
      "time",
      "severity",
      "message",
      "state"
     ],
     "ack_on_tap": true,
     "style": {
      "bg_color": "#101827",
      "border_width": 0,
      "radius": 8
     },
     "bind": {
      "visible": {
       "tag": "alarm_view",
       "eq": 0
      }
     }
    },
    {
     "type": "alarm_list",
     "x": 0,
     "y": 64,
     "w": 880,
     "h": 448,
     "mode": "history",
     "days": 7,
     "row_height": 48,
     "columns": [
      "time",
      "severity",
      "message",
      "state"
     ],
     "ack_on_tap": false,
     "style": {
      "bg_color": "#101827",
      "border_width": 0,
      "radius": 8
     },
     "bind": {
      "visible": {
       "tag": "alarm_view",
       "eq": 1
      }
     }
    }
   ]
  },
  {
