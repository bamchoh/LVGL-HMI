  "scripts": [
    {
      "name": "line_status",
      "trigger": "interval",
      "interval_ms": 500,
      "code": [
        "local function on(v) return v == true or (type(v) == 'number' and v ~= 0) end",
        "local function st(run, fault) if on(fault) then return 2 elseif on(run) then return 1 else return 0 end end",
        "local states = {}",
        "do local s = st(tag.feeder_running, tag.feeder_fault) if s == 1 and tag.feeder_flour_level < 5 then s = 3 end tag.feeder_state = s; states[#states+1] = s end",
        "do local s = st(tag.mixer_running, tag.mixer_fault) if s == 1 and tag.mixer_load > 90 then s = 3 end tag.mixer_state = s; states[#states+1] = s end",
        "do local s = st(tag.divider_running, tag.divider_fault) tag.divider_state = s; states[#states+1] = s end",
        "do local s = st(tag.proofing_running, tag.proofing_fault) tag.proofing_state = s; states[#states+1] = s end",
        "do local s = st(tag.oven_running, tag.oven_fault) tag.oven_state = s; states[#states+1] = s end",
        "do local s = st(tag.cooling_running, tag.cooling_fault) tag.cooling_state = s; states[#states+1] = s end",
        "do local s = st(tag.slicer_running, tag.slicer_fault) tag.slicer_state = s; states[#states+1] = s end",
        "do local s = st(tag.packaging_running, tag.packaging_fault) if s == 1 and tag.packaging_film_remaining < 10 then s = 3 end tag.packaging_state = s; states[#states+1] = s end",
        "local fault, warn, running = on(tag.conveyor_fault) or on(tag.plc_comm_error), false, 0",
        "for _, s in ipairs(states) do if s == 2 then fault = true elseif s == 3 then warn = true end if s == 1 or s == 3 then running = running + 1 end end",
        "if fault then tag.line_state = 2 elseif running == 0 or not on(tag.conveyor_running) then tag.line_state = 0 elseif warn then tag.line_state = 3 else tag.line_state = 1 end",
        "tag.conveyor_state = st(tag.conveyor_running, tag.conveyor_fault)",
        "tag.production_count = tag.prod_white_bread + tag.prod_baguette + tag.prod_roll",
        "tag.good_count = math.max(0, tag.production_count - tag.defect_count)",
        "if tag.production_target > 0 then tag.achievement_rate = tag.production_count * 100.0 / tag.production_target else tag.achievement_rate = 0 end",
        "tag.mixer_remaining_time = math.max(0, tag.mixer_time_sp - tag.mixer_elapsed_time)"
      ]
    }
  ],
