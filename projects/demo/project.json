{
  "title": "HML Demo - Pump Station",
  "display": {
    "width": 800,
    "height": 480,
    "zoom": 1,
    "touch": {}
  },
  "theme": {
    "dark": true,
    "primary": "#2196f3",
    "secondary": "#ff9800",
    "font": 16
  },
  "start_screen": "main",
  "tags": [
    {
      "name": "temp",
      "type": "float",
      "init": 20
    },
    {
      "name": "pressure",
      "type": "float",
      "init": 1.5
    },
    {
      "name": "level",
      "type": "int",
      "init": 0,
      "min": 0,
      "max": 100
    },
    {
      "name": "speed_sp",
      "type": "int",
      "init": 40,
      "min": 0,
      "max": 100
    },
    {
      "name": "speed_pv",
      "type": "int",
      "init": 0,
      "min": 0,
      "max": 100
    },
    {
      "name": "run",
      "type": "bool",
      "init": false
    },
    {
      "name": "auto_mode",
      "type": "bool",
      "init": true
    },
    {
      "name": "state_text",
      "type": "string",
      "init": "Idle"
    },
    {
      "name": "mode",
      "type": "int",
      "init": 0,
      "min": 0,
      "max": 2
    },
    {
      "name": "setpoint",
      "type": "int",
      "init": 50,
      "min": 0,
      "max": 100
    },
    {
      "name": "operator",
      "type": "string",
      "init": ""
    },
    {
      "name": "plc_online",
      "type": "bool",
      "init": false
    },
    {
      "name": "pin",
      "type": "string",
      "init": ""
    },
    {
      "name": "temp_lo",
      "type": "float",
      "init": 20,
      "min": 0,
      "max": 50
    },
    {
      "name": "temp_hi",
      "type": "float",
      "init": 30,
      "min": 0,
      "max": 50
    },
    {
      "name": "blink",
      "type": "bool",
      "init": false
    }
  ],
  "drivers": [
    {
      "type": "sim",
      "items": [
        {
          "tag": "temp",
          "mode": "sine",
          "min": 18,
          "max": 32,
          "period_ms": 12000
        },
        {
          "tag": "pressure",
          "mode": "triangle",
          "min": 1,
          "max": 3.5,
          "period_ms": 7000
        },
        {
          "tag": "level",
          "mode": "ramp",
          "min": 0,
          "max": 100,
          "period_ms": 20000
        },
        {
          "tag": "state_text",
          "mode": "cycle",
          "values": [
            "Idle",
            "Starting",
            "Running",
            "Stopping"
          ],
          "period_ms": 3000
        },
        {
          "tag": "blink",
          "mode": "square",
          "period_ms": 1000
        }
      ]
    },
    {
      "type": "opcua_server",
      "port": 4840,
      "namespace": "urn:hml:runtime",
      "folder": "HML"
    },
    {
      "type": "modbus_tcp",
      "enabled": true,
      "host": "127.0.0.1",
      "port": 5020,
      "unit_id": 1,
      "poll_ms": 200,
      "timeout_ms": 1000,
      "status_tag": "plc_online",
      "map": [
        {
          "tag": "speed_sp",
          "area": "holding",
          "addr": 0
        },
        {
          "tag": "speed_pv",
          "area": "input",
          "addr": 0
        },
        {
          "tag": "setpoint",
          "area": "holding",
          "addr": 1
        },
        {
          "tag": "temp_lo",
          "area": "holding",
          "addr": 2,
          "dtype": "s16",
          "scale": 0.1
        },
        {
          "tag": "temp_hi",
          "area": "holding",
          "addr": 3,
          "dtype": "s16",
          "scale": 0.1
        },
        {
          "tag": "run",
          "area": "coil",
          "addr": 0
        },
        {
          "tag": "auto_mode",
          "area": "coil",
          "addr": 1
        }
      ]
    }
  ],
  "data_log": {
    "groups": [
      { "name": "process", "trigger": "interval", "interval_ms": 1000, "tags": ["temp", "pressure", "level", "speed_sp", "speed_pv"] },
      { "name": "state", "trigger": "change", "tags": ["run", "auto_mode", "mode"] }
    ]
  },
  "alarms": {
    "items": [
      { "name": "temp_high", "tag": "temp", "condition": "gt", "value_tag": "temp_hi", "severity": "warning", "message": "Temperature high" },
      { "name": "temp_low", "tag": "temp", "condition": "lt", "value_tag": "temp_lo", "severity": "warning", "message": "Temperature low" }
    ]
  },
  "operation_log": {
    "user_tag": "operator"
  },
  "system_log": {
    "retention_days": 30,
    "max_rows": 100000
  },
  "scripts": [
    {
      "name": "auto_speed",
      "trigger": "interval",
      "code": "-- Auto mode: while the pump runs, the speed setpoint follows the temperature\n-- (18 C -> 0 %, 32 C -> 100 %). Switch \"Auto mode\" off to use the slider.\nif tag.auto_mode and tag.run then\n  local pct = (tag.temp - 18) / (32 - 18) * 100\n  tag.speed_sp = math.floor(math.max(0, math.min(100, pct)) + 0.5)\nend\n",
      "interval_ms": 500
    }
  ],
  "screens": [
    "screens/main.json",
    "screens/settings.json"
  ]
}
