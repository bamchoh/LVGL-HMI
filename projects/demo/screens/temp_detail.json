{
  "name": "temp_detail",
  "popup": true,
  "w": 420, "h": 260,
  "style": { "bg_color": "#1f2a38", "radius": 10 },
  "children": [
    { "type": "label", "text": "Temperature", "x": 4, "y": 0, "style": { "font": 20, "text_color": "#ffffff" } },
    { "type": "label", "align": "top_right", "x": -4, "y": 2, "style": { "font": 20, "text_color": "#4fc3f7" },
      "bind": { "text": { "tag": "temp", "format": "%.1f C" } } },
    { "type": "label", "text": "Low limit", "x": 4, "y": 64, "style": { "text_color": "#9fb3c8" } },
    { "type": "numeric_display", "input": true, "x": 140, "y": 54, "w": 120, "decimals": 1, "unit": " C", "bind": "temp_lo" },
    { "type": "label", "text": "High limit", "x": 4, "y": 116, "style": { "text_color": "#9fb3c8" } },
    { "type": "numeric_display", "input": true, "x": 140, "y": 106, "w": 120, "decimals": 1, "unit": " C", "bind": "temp_hi" },
    { "type": "button", "align": "bottom_right", "w": 110, "h": 44, "text": "Close", "on_click": { "action": "close" } }
  ]
}
