{
  "name": "main",
  "scrollable": false,
  "style": {
    "bg_color": "#141a22",
    "pad": 0
  },
  "children": [
    {
      "type": "panel",
      "x": 0,
      "y": 0,
      "w": "100%",
      "h": 48,
      "scrollable": false,
      "style": {
        "bg_color": "#1f2a38",
        "radius": 0,
        "border_width": 0,
        "pad": 0,
        "pad_left": 16,
        "pad_right": 16
      },
      "children": [
        {
          "type": "image",
          "src": "assets/logo.png",
          "align": "left_mid",
          "x": -8,
          "zoom": 0.6
        },
        {
          "type": "label",
          "text": "@title",
          "align": "left_mid",
          "x": 32,
          "style": {
            "font": 20,
            "text_color": "#ffffff"
          }
        },
        {
          "type": "alarm_banner",
          "align": "center",
          "w": 304,
          "h": 36,
          "labels": {
            "idle": "@no_alarms",
            "more": "@alarm_more"
          }
        },
        {
          "type": "led",
          "align": "right_mid",
          "x": -176,
          "w": 14,
          "h": 14,
          "color": "#4caf50",
          "bind": {
            "on": "plc_online"
          }
        },
        {
          "type": "label",
          "text": "PLC",
          "align": "right_mid",
          "x": -140,
          "style": {
            "font": 14
          },
          "bind": {
            "text_color": {
              "tag": "plc_online",
              "map": {
                "true": "#4caf50",
                "false": "#78909c"
              }
            }
          }
        },
        {
          "type": "label",
          "align": "right_mid",
          "clickable": true,
          "on_click": {
            "action": "login"
          },
          "style": {
            "text_color": "#9fb3c8",
            "font": 14
          },
          "bind": {
            "text": {
              "tag": "sys.user.name",
              "format": "User: %s"
            }
          }
        }
      ]
    },
    {
      "type": "panel",
      "x": 16,
      "y": 56,
      "w": 248,
      "h": 120,
      "scrollable": false,
      "style": {
        "bg_color": "#1b2430",
        "radius": 10,
        "border_width": 0,
        "pad": 12
      },
      "on_click": {
        "action": "popup",
        "screen": "temp_detail"
      },
      "children": [
        {
          "type": "label",
          "text": "@temperature",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "panel",
          "align": "top_right",
          "w": 88,
          "h": 32,
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0
          },
          "children": [
            {
              "type": "panel",
              "align": "right_mid",
              "w": 88,
              "h": 32,
              "scrollable": false,
              "style": {
                "bg_color": "#2e7d32",
                "radius": 6,
                "border_width": 0,
                "pad": 0
              },
              "children": [
                {
                  "type": "label",
                  "text": "@st_normal",
                  "align": "center",
                  "style": {
                    "text_color": "#ffffff",
                    "font": 14
                  }
                }
              ]
            },
            {
              "type": "panel",
              "align": "right_mid",
              "w": 88,
              "h": 32,
              "scrollable": false,
              "style": {
                "bg_color": "#f9a825",
                "radius": 6,
                "border_width": 0,
                "pad": 0
              },
              "children": [
                {
                  "type": "label",
                  "text": "@st_low",
                  "align": "center",
                  "style": {
                    "text_color": "#ffffff",
                    "font": 14
                  }
                }
              ],
              "bind": {
                "visible": {
                  "tag": "temp",
                  "lt": {
                    "tag": "temp_lo"
                  }
                }
              }
            },
            {
              "type": "panel",
              "align": "right_mid",
              "w": 88,
              "h": 32,
              "scrollable": false,
              "style": {
                "bg_color": "#c62828",
                "radius": 6,
                "border_width": 0,
                "pad": 0
              },
              "children": [
                {
                  "type": "label",
                  "text": "@st_high",
                  "align": "center",
                  "style": {
                    "text_color": "#ffffff",
                    "font": 14
                  }
                }
              ],
              "bind": {
                "visible": {
                  "tag": "temp",
                  "gt": {
                    "tag": "temp_hi"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "label",
          "align": "center",
          "y": 8,
          "style": {
            "font": 32,
            "text_color": "#ffffff"
          },
          "bind": {
            "text": {
              "tag": "temp",
              "format": "%.1f C"
            }
          }
        },
        {
          "type": "bar",
          "align": "bottom_mid",
          "w": "100%",
          "h": 8,
          "min": 0,
          "max": 50,
          "bind": {
            "value": "temp"
          }
        }
      ]
    },
    {
      "type": "panel",
      "x": 276,
      "y": 56,
      "w": 248,
      "h": 120,
      "scrollable": false,
      "style": {
        "bg_color": "#1b2430",
        "radius": 10,
        "border_width": 0,
        "pad": 12
      },
      "children": [
        {
          "type": "label",
          "text": "@pressure",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "arc",
          "align": "right_mid",
          "w": 96,
          "h": 96,
          "min": 0,
          "max": 40,
          "adjustable": false,
          "bind": {
            "value": {
              "tag": "pressure",
              "scale": 10
            }
          },
          "style": {
            "arc_width": 10
          },
          "style_indicator": {
            "arc_color": "#ff9800",
            "arc_width": 10
          }
        },
        {
          "type": "label",
          "align": "left_mid",
          "y": 10,
          "style": {
            "font": 28,
            "text_color": "#ffffff"
          },
          "bind": {
            "text": {
              "tag": "pressure",
              "format": "%.2f"
            }
          }
        },
        {
          "type": "label",
          "text": "bar",
          "align": "bottom_left",
          "style": {
            "text_color": "#9fb3c8"
          }
        }
      ]
    },
    {
      "type": "panel",
      "x": 536,
      "y": 56,
      "w": 248,
      "h": 120,
      "scrollable": false,
      "style": {
        "bg_color": "#1b2430",
        "radius": 10,
        "border_width": 0,
        "pad": 12
      },
      "children": [
        {
          "type": "label",
          "text": "@level",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "bar",
          "align": "right_mid",
          "w": 40,
          "h": 96,
          "min": 0,
          "max": 100,
          "bind": {
            "value": "level"
          },
          "style": {
            "radius": 4
          },
          "style_indicator": {
            "bg_color": "#26a69a",
            "radius": 4
          }
        },
        {
          "type": "label",
          "align": "left_mid",
          "y": 10,
          "style": {
            "font": 28,
            "text_color": "#ffffff"
          },
          "bind": {
            "text": {
              "tag": "level",
              "format": "%d %%"
            }
          }
        },
        {
          "type": "label",
          "text": "@level_high",
          "align": "bottom_left",
          "style": {
            "text_color": "#f9a825",
            "font": 14
          },
          "bind": {
            "visible": {
              "tag": "level",
              "ge": 95
            }
          },
          "animate": {
            "preset": "blink",
            "when": {
              "tag": "level",
              "ge": 95
            }
          }
        }
      ]
    },
    {
      "type": "panel",
      "x": 16,
      "y": 184,
      "w": 508,
      "h": 232,
      "scrollable": false,
      "style": {
        "bg_color": "#1b2430",
        "radius": 10,
        "border_width": 0,
        "pad": 12
      },
      "children": [
        {
          "type": "label",
          "text": "@live_chart",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "chart",
          "align": "bottom_mid",
          "w": "100%",
          "h": 176,
          "chart_type": "line",
          "points": 120,
          "min": 0,
          "max": 100,
          "sample_ms": 500,
          "hdiv": 4,
          "vdiv": 6,
          "series": [
            {
              "tag": "temp",
              "color": "#42a5f5",
              "scale": 2
            },
            {
              "tag": "level",
              "color": "#26a69a"
            },
            {
              "tag": "speed_pv",
              "color": "#ffa726"
            }
          ],
          "style": {
            "bg_color": "#10151c",
            "border_width": 0,
            "radius": 6
          }
        }
      ]
    },
    {
      "type": "panel",
      "x": 536,
      "y": 184,
      "w": 248,
      "h": 232,
      "scrollable": false,
      "style": {
        "bg_color": "#1b2430",
        "radius": 10,
        "border_width": 0,
        "pad": 12,
        "pad_row": 8
      },
      "flex": "column",
      "flex_cross": "center",
      "children": [
        {
          "type": "panel",
          "w": "100%",
          "h": "content",
          "flex": "row",
          "flex_cross": "center",
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0,
            "pad_column": 8
          },
          "children": [
            {
              "type": "label",
              "text": "@pump",
              "style": {
                "text_color": "#ffffff"
              }
            },
            {
              "type": "panel",
              "w": 80,
              "h": 24,
              "flex_grow": 1,
              "scrollable": false,
              "style": {
                "bg_opa": 0,
                "border_width": 0,
                "pad": 0
              },
              "children": [
                {
                  "type": "label",
                  "text": "@ps_idle",
                  "style": {
                    "text_color": "#78909c"
                  },
                  "bind": {
                    "visible": {
                      "tag": "pump_state",
                      "eq": 0
                    }
                  }
                },
                {
                  "type": "label",
                  "text": "@ps_starting",
                  "style": {
                    "text_color": "#f9a825"
                  },
                  "bind": {
                    "visible": {
                      "tag": "pump_state",
                      "eq": 1
                    }
                  }
                },
                {
                  "type": "label",
                  "text": "@ps_running",
                  "style": {
                    "text_color": "#66bb6a"
                  },
                  "bind": {
                    "visible": {
                      "tag": "pump_state",
                      "eq": 2
                    }
                  }
                },
                {
                  "type": "label",
                  "text": "@ps_stopping",
                  "style": {
                    "text_color": "#f9a825"
                  },
                  "bind": {
                    "visible": {
                      "tag": "pump_state",
                      "eq": 3
                    }
                  }
                }
              ]
            },
            {
              "type": "switch",
              "w": 56,
              "h": 32,
              "bind": "run"
            }
          ]
        },
        {
          "type": "panel",
          "w": "100%",
          "h": "content",
          "flex": "row",
          "flex_cross": "center",
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0,
            "pad_column": 8
          },
          "flex_main": "space_between",
          "children": [
            {
              "type": "label",
              "text": "SP",
              "style": {
                "text_color": "#9fb3c8"
              }
            },
            {
              "type": "numeric_display",
              "w": 76,
              "input": true,
              "min": 0,
              "max": 100,
              "unit": " %",
              "bind": "speed_sp"
            },
            {
              "type": "label",
              "text": "PV",
              "style": {
                "text_color": "#9fb3c8"
              }
            },
            {
              "type": "numeric_display",
              "w": 76,
              "unit": " %",
              "bind": "speed_pv"
            }
          ]
        },
        {
          "type": "slider",
          "w": "92%",
          "min": 0,
          "max": 100,
          "bind": {
            "value": "speed_sp",
            "enabled": {
              "tag": "auto_mode",
              "invert": true
            }
          }
        },
        {
          "type": "panel",
          "w": "100%",
          "h": "content",
          "flex": "row",
          "flex_cross": "center",
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0,
            "pad_column": 0
          },
          "flex_main": "space_between",
          "children": [
            {
              "type": "button",
              "text": "-10",
              "w": 68,
              "h": 44,
              "on_click": {
                "action": "dec",
                "tag": "speed_sp",
                "by": 10
              },
              "bind": {
                "enabled": {
                  "tag": "auto_mode",
                  "invert": true
                }
              }
            },
            {
              "type": "button",
              "text": "+10",
              "w": 68,
              "h": 44,
              "on_click": {
                "action": "inc",
                "tag": "speed_sp",
                "by": 10
              },
              "bind": {
                "enabled": {
                  "tag": "auto_mode",
                  "invert": true
                }
              }
            },
            {
              "type": "button",
              "text": "@stop",
              "w": 68,
              "h": 44,
              "style": {
                "bg_color": "#c62828"
              },
              "on_click": [
                {
                  "action": "set",
                  "tag": "run",
                  "value": false
                }
              ]
            }
          ]
        },
        {
          "type": "checkbox",
          "text": "@auto_mode",
          "bind": "auto_mode"
        }
      ]
    },
    {
      "type": "panel",
      "x": 0,
      "y": 424,
      "w": "100%",
      "h": 56,
      "scrollable": false,
      "flex": "row",
      "flex_main": "center",
      "flex_cross": "center",
      "style": {
        "bg_color": "#1f2a38",
        "radius": 0,
        "border_width": 0,
        "pad": 0,
        "pad_column": 8
      },
      "children": [
        {
          "type": "button",
          "text": "@main",
          "w": 104,
          "h": 48,
          "style": {
            "bg_color": "#1565c0"
          },
          "on_click": {
            "action": "goto",
            "screen": "main",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@trend",
          "w": 104,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "trend",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@alarms",
          "w": 104,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "alarms",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@recipes",
          "w": 104,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "recipes",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@widgets",
          "w": 104,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "widgets",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@settings",
          "w": 104,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "settings",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@production",
          "w": 104,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "production",
            "anim": "fade"
          }
        }
      ]
    },
    {
      "type": "keyboard",
      "align": "bottom_mid",
      "w": "100%",
      "h": 220,
      "style_items": {
        "font": 18
      }
    }
  ]
}
