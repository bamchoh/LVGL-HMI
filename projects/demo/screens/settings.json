{
  "name": "settings",
  "scrollable": false,
  "style": {
    "bg_color": "#141a22",
    "pad": 0
  },
  "children": [
    {
      "type": "panel",
      "x": 0,
      "y": 0,
      "w": "100%",
      "h": 48,
      "scrollable": false,
      "style": {
        "bg_color": "#1f2a38",
        "radius": 0,
        "border_width": 0,
        "pad": 0,
        "pad_left": 16,
        "pad_right": 16
      },
      "children": [
        {
          "type": "image",
          "src": "assets/logo.png",
          "align": "left_mid",
          "x": -8,
          "zoom": 0.6
        },
        {
          "type": "label",
          "text": "@title",
          "align": "left_mid",
          "x": 32,
          "style": {
            "font": 20,
            "text_color": "#ffffff"
          }
        },
        {
          "type": "alarm_banner",
          "align": "center",
          "w": 304,
          "h": 36,
          "labels": {
            "idle": "@no_alarms",
            "more": "@alarm_more"
          }
        },
        {
          "type": "led",
          "align": "right_mid",
          "x": -176,
          "w": 14,
          "h": 14,
          "color": "#4caf50",
          "bind": {
            "on": "plc_online"
          }
        },
        {
          "type": "label",
          "text": "PLC",
          "align": "right_mid",
          "x": -140,
          "style": {
            "font": 14
          },
          "bind": {
            "text_color": {
              "tag": "plc_online",
              "map": {
                "true": "#4caf50",
                "false": "#78909c"
              }
            }
          }
        },
        {
          "type": "label",
          "align": "right_mid",
          "clickable": true,
          "on_click": {
            "action": "login"
          },
          "style": {
            "text_color": "#9fb3c8",
            "font": 14
          },
          "bind": {
            "text": {
              "tag": "sys.user.name",
              "format": "User: %s"
            }
          }
        }
      ]
    },
    {
      "type": "panel",
      "x": 16,
      "y": 56,
      "w": 248,
      "h": 360,
      "scrollable": false,
      "style": {
        "bg_color": "#1b2430",
        "radius": 10,
        "border_width": 0,
        "pad": 12,
        "pad_row": 8
      },
      "flex": "column",
      "children": [
        {
          "type": "label",
          "text": "@operation_mode",
          "w": "100%",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "dropdown",
          "w": "100%",
          "options": [
            "@mode_manual",
            "@mode_auto",
            "@mode_maint"
          ],
          "bind": "mode"
        },
        {
          "type": "label",
          "text": "@operator_name",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "text_display",
          "w": "100%",
          "max_length": 16,
          "input": true,
          "bind": "operator"
        },
        {
          "type": "label",
          "text": "@temp_limits",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "panel",
          "w": "100%",
          "h": "content",
          "flex": "row",
          "flex_cross": "center",
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0,
            "pad_column": 0
          },
          "flex_main": "space_between",
          "children": [
            {
              "type": "numeric_display",
              "w": 106,
              "input": true,
              "min": 0,
              "max": 50,
              "decimals": 1,
              "unit": " C",
              "bind": "temp_lo"
            },
            {
              "type": "numeric_display",
              "w": 106,
              "input": true,
              "min": 0,
              "max": 50,
              "decimals": 1,
              "unit": " C",
              "bind": "temp_hi"
            }
          ]
        }
      ]
    },
    {
      "type": "panel",
      "x": 276,
      "y": 56,
      "w": 248,
      "h": 360,
      "scrollable": false,
      "style": {
        "bg_color": "#1b2430",
        "radius": 10,
        "border_width": 0,
        "pad": 12,
        "pad_row": 8
      },
      "flex": "column",
      "flex_cross": "center",
      "children": [
        {
          "type": "label",
          "text": "@setpoint",
          "w": "100%",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "arc",
          "w": 144,
          "h": 144,
          "min": 0,
          "max": 100,
          "bind": "setpoint",
          "style_indicator": {
            "arc_color": "#2196f3"
          },
          "style_knob": {
            "bg_color": "#2196f3"
          }
        },
        {
          "type": "numeric_display",
          "w": 128,
          "input": true,
          "min": 0,
          "max": 100,
          "unit": " %",
          "bind": "setpoint",
          "style": {
            "font": 24,
            "text_color": "#ffffff"
          }
        },
        {
          "type": "panel",
          "w": "100%",
          "h": "content",
          "flex": "row",
          "flex_cross": "center",
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0,
            "pad_column": 0
          },
          "flex_main": "space_between",
          "children": [
            {
              "type": "button",
              "text": "0",
              "w": 68,
              "h": 48,
              "on_click": {
                "action": "set",
                "tag": "setpoint",
                "value": 0
              }
            },
            {
              "type": "button",
              "text": "50",
              "w": 68,
              "h": 48,
              "on_click": {
                "action": "set",
                "tag": "setpoint",
                "value": 50
              }
            },
            {
              "type": "button",
              "text": "100",
              "w": 68,
              "h": 48,
              "on_click": {
                "action": "set",
                "tag": "setpoint",
                "value": 100
              }
            }
          ]
        }
      ]
    },
    {
      "type": "panel",
      "x": 536,
      "y": 56,
      "w": 248,
      "h": 360,
      "scrollable": false,
      "style": {
        "bg_color": "#1b2430",
        "radius": 10,
        "border_width": 0,
        "pad": 12,
        "pad_row": 8
      },
      "flex": "column",
      "children": [
        {
          "type": "label",
          "text": "@user_and_system",
          "w": "100%",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "panel",
          "w": "100%",
          "h": "content",
          "flex": "row",
          "flex_cross": "center",
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0,
            "pad_column": 0
          },
          "flex_main": "space_between",
          "children": [
            {
              "type": "button",
              "text": "@login",
              "w": 108,
              "h": 48,
              "on_click": {
                "action": "login"
              }
            },
            {
              "type": "button",
              "text": "@logout",
              "w": 108,
              "h": 48,
              "style": {
                "bg_color": "#455a64"
              },
              "on_click": {
                "action": "logout"
              }
            }
          ]
        },
        {
          "type": "panel",
          "w": "100%",
          "h": "content",
          "flex": "row",
          "flex_cross": "center",
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0,
            "pad_column": 0
          },
          "flex_main": "space_between",
          "children": [
            {
              "type": "button",
              "text": "@language",
              "w": 108,
              "h": 48,
              "style": {
                "bg_color": "#6d4c41"
              },
              "on_click": {
                "action": "language"
              }
            },
            {
              "type": "button",
              "text": "@system",
              "w": 108,
              "h": 48,
              "style": {
                "bg_color": "#455a64"
              },
              "on_click": {
                "action": "system"
              }
            }
          ]
        },
        {
          "type": "label",
          "text": "@maintenance",
          "style": {
            "text_color": "#9fb3c8"
          }
        },
        {
          "type": "panel",
          "w": "100%",
          "h": "content",
          "flex": "row",
          "flex_cross": "center",
          "scrollable": false,
          "style": {
            "bg_opa": 0,
            "border_width": 0,
            "pad": 0,
            "pad_column": 0
          },
          "flex_main": "space_between",
          "children": [
            {
              "type": "button",
              "text": "@reload",
              "w": 108,
              "h": 48,
              "style": {
                "bg_color": "#455a64"
              },
              "on_click": {
                "action": "reload"
              },
              "level": 2,
              "level_deny": "login"
            },
            {
              "type": "button",
              "text": "@restart",
              "w": 108,
              "h": 48,
              "style": {
                "bg_color": "#ef6c00"
              },
              "on_click": {
                "action": "restart"
              },
              "level": 2,
              "level_deny": "login"
            }
          ]
        },
        {
          "type": "button",
          "text": "@exit",
          "w": 108,
          "h": 48,
          "style": {
            "bg_color": "#c62828"
          },
          "on_click": {
            "action": "exit"
          },
          "level": 2,
          "level_deny": "login"
        }
      ]
    },
    {
      "type": "panel",
      "x": 0,
      "y": 424,
      "w": "100%",
      "h": 56,
      "scrollable": false,
      "flex": "row",
      "flex_main": "center",
      "flex_cross": "center",
      "style": {
        "bg_color": "#1f2a38",
        "radius": 0,
        "border_width": 0,
        "pad": 0,
        "pad_column": 8
      },
      "children": [
        {
          "type": "button",
          "text": "@main",
          "w": 120,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "main",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@trend",
          "w": 120,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "trend",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@alarms",
          "w": 120,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "alarms",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@recipes",
          "w": 120,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "recipes",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@widgets",
          "w": 120,
          "h": 48,
          "style": {
            "bg_color": "#37474f"
          },
          "on_click": {
            "action": "goto",
            "screen": "widgets",
            "anim": "fade"
          }
        },
        {
          "type": "button",
          "text": "@settings",
          "w": 120,
          "h": 48,
          "style": {
            "bg_color": "#1565c0"
          },
          "on_click": {
            "action": "goto",
            "screen": "settings",
            "anim": "fade"
          }
        }
      ]
    },
    {
      "type": "keyboard",
      "align": "bottom_mid",
      "w": "100%",
      "h": 220,
      "style_items": {
        "font": 18
      }
    }
  ]
}
