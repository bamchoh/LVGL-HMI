{
  "name": "settings",
  "scrollable": false,
  "style": { "bg_color": "#141a22", "pad": 0 },
  "children": [
    {
      "type": "panel", "x": 0, "y": 0, "w": "100%", "h": 56, "scrollable": false,
      "style": { "bg_color": "#1f2a38", "radius": 0, "border_width": 0, "pad_left": 16, "pad_right": 16 },
      "children": [
        { "type": "button", "align": "left_mid", "text": "< Back", "w": 90, "h": 36,
          "on_click": { "action": "back" } },
        { "type": "label", "text": "Settings", "align": "center", "style": { "font": 24, "text_color": "#ffffff" } },
        { "type": "label", "align": "right_mid", "style": { "text_color": "#9fb3c8", "font": 14 },
          "bind": { "text": { "tag": "operator", "format": "Operator: %s" } } }
      ]
    },

    {
      "type": "panel", "x": 16, "y": 72, "w": 370, "h": 300, "scrollable": false,
      "flex": "column", "style": { "bg_color": "#1b2430", "radius": 10, "border_width": 0, "pad_row": 6 },
      "children": [
        { "type": "label", "text": "Operation mode", "style": { "text_color": "#9fb3c8" } },
        { "type": "dropdown", "w": "100%", "options": ["Manual", "Automatic", "Maintenance"], "bind": "mode" },
        { "type": "label", "style": { "text_color": "#ffffff" },
          "bind": { "text": { "tag": "mode", "format": "mode tag = %d" } } },
        { "type": "label", "text": "Maintenance mode is active!", "style": { "text_color": "#f44336" },
          "bind": { "visible": { "tag": "mode", "eq": 2 } } },
        { "type": "label", "text": "Operator name", "style": { "text_color": "#9fb3c8" } },
        { "type": "text_display", "w": "100%", "placeholder": "type a name, Enter to confirm", "max_length": 24,
          "input": true, "bind": "operator" },
        { "type": "label", "text": "Maintenance PIN (1234 unlocks)", "style": { "text_color": "#9fb3c8" } },
        { "type": "panel", "w": "100%", "h": "content", "flex": "row", "flex_cross": "center", "scrollable": false,
          "style": { "bg_opa": 0, "border_width": 0, "pad": 0, "pad_column": 10 },
          "children": [
            { "type": "password_display", "w": 120, "max_length": 4, "accepted_chars": "0123456789", "placeholder": "PIN", "bind": "pin" },
            { "type": "label", "text": "unlocked", "style": { "text_color": "#4caf50" }, "bind": { "visible": { "tag": "pin", "eq": "1234" } } },
            { "type": "label", "text": "locked", "style": { "text_color": "#f44336" }, "bind": { "hidden": { "tag": "pin", "eq": "1234" } } }
          ] }
      ]
    },

    {
      "type": "panel", "x": 402, "y": 72, "w": 382, "h": 300, "scrollable": false,
      "flex": "column", "flex_cross": "center", "style": { "bg_color": "#1b2430", "radius": 10, "border_width": 0, "pad_row": 6 },
      "children": [
        { "type": "label", "text": "Setpoint (holding reg 1)", "style": { "text_color": "#9fb3c8" } },
        { "type": "arc", "w": 150, "h": 150, "min": 0, "max": 100, "bind": "setpoint",
          "style_indicator": { "arc_color": "#2196f3" }, "style_knob": { "bg_color": "#2196f3" } },
        { "type": "numeric_display", "w": 140, "input": true, "min": 0, "max": 100, "unit": " %",
          "style": { "font": 28, "text_color": "#ffffff" }, "bind": "setpoint" },
        { "type": "panel", "w": "100%", "h": "content", "flex": "row", "flex_main": "space_evenly", "scrollable": false,
          "style": { "bg_opa": 0, "border_width": 0, "pad": 0 },
          "children": [
            { "type": "button", "text": "0",   "w": 60, "on_click": { "action": "set", "tag": "setpoint", "value": 0 } },
            { "type": "button", "text": "50",  "w": 60, "on_click": { "action": "set", "tag": "setpoint", "value": 50 } },
            { "type": "button", "text": "100", "w": 60, "on_click": { "action": "set", "tag": "setpoint", "value": 100 } }
          ] }
      ]
    },

    {
      "type": "panel", "x": 16, "y": 388, "w": 768, "h": 76, "scrollable": false,
      "flex": "row", "flex_main": "space_between", "flex_cross": "center",
      "style": { "bg_color": "#1b2430", "radius": 10, "border_width": 0 },
      "children": [
        { "type": "label", "style": { "text_color": "#9fb3c8", "font": 14 },
          "text": "F5 = reload screens, Esc = quit" },
        { "type": "panel", "w": "content", "h": "content", "flex": "row", "scrollable": false,
          "style": { "bg_opa": 0, "border_width": 0, "pad": 0, "pad_column": 8 },
          "children": [
            { "type": "button", "text": "Reload", "on_click": { "action": "reload" } },
            { "type": "button", "text": "Main", "on_click": { "action": "goto", "screen": "main", "anim": "slide_right" } },
            { "type": "button", "text": "System", "style": { "bg_color": "#455a64" }, "on_click": { "action": "system" } },
            { "type": "button", "text": "Restart", "style": { "bg_color": "#ef6c00" }, "on_click": { "action": "restart" } },
            { "type": "button", "text": "Exit", "style": { "bg_color": "#455a64" }, "on_click": { "action": "exit" } }
          ] }
      ]
    },

    { "type": "keyboard", "align": "bottom_mid", "w": "100%", "h": 200 }
  ]
}
