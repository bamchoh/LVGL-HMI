// The version information of a Windows program (Explorer > Properties > Details; what a code
// signing service checks before it signs). Filled in by CMake: see hml_version_resource().
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @HML_VER_MAJOR@,@HML_VER_MINOR@,@HML_VER_PATCH@,0
 PRODUCTVERSION  @HML_VER_MAJOR@,@HML_VER_MINOR@,@HML_VER_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",      "Tsukuraku"
            VALUE "ProductVersion",   "@HML_VERSION@"
            VALUE "FileVersion",      "@HML_VERSION@"
            VALUE "FileDescription",  "@HML_RC_DESCRIPTION@"
            VALUE "InternalName",     "@HML_RC_TARGET@"
            VALUE "OriginalFilename", "@HML_RC_TARGET@.exe"
            VALUE "LegalCopyright",   "Copyright 2026 bamchoh. Apache License 2.0."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
